From de9a26e7e151495f893b3011307ff29926155139 Mon Sep 17 00:00:00 2001
From: yifengyou <842056007@qq.com>
Date: Tue, 15 Sep 2026 14:06:41 +0800
Subject: [PATCH] update uboot adapt for bdy g98

Signed-off-by: yifengyou <842056007@qq.com>

diff --git a/u-boot/arch/arm/mach-rockchip/board.c b/u-boot/arch/arm/mach-rockchip/board.c
index f07c66c29..00a705c20 100644
--- a/u-boot/arch/arm/mach-rockchip/board.c
+++ b/u-boot/arch/arm/mach-rockchip/board.c
@@ -62,7 +62,6 @@ static ulong orig_images_ep;
 
 __weak int rk_board_late_init(void)
 {
-	run_command("gpio clear 138; gpio set 139; gpio clear 140;", 0);
 	return 0;
 }
 
@@ -88,8 +87,6 @@ __weak int set_armclk_rate(void)
 
 __weak int rk_board_init(void)
 {
-	run_command("gpio set 130", 0);//GPIO4_A2 vcc 5v
-        run_command("gpio set 100", 0);//GPIO3_A4 TYPEC0_PWR_EN
 	return 0;
 }
 
diff --git a/u-boot/cmd/kbi.c b/u-boot/cmd/kbi.c
index 6e0227a43..ba12704fd 100644
--- a/u-boot/cmd/kbi.c
+++ b/u-boot/cmd/kbi.c
@@ -253,6 +253,7 @@ static void get_version(void)
 
 static void get_usid(void)
 {
+	/*
 	char serial[64]={0};
 	char usid[USID_LENGHT] = {0};
 
@@ -260,6 +261,14 @@ static void get_usid(void)
 	sprintf(serial, "%02X%02X%02X%02X%02X%02X%02X",usid[0],usid[1],usid[2],usid[3],usid[4],usid[5],usid[6]);
 	printf("usid:%s\r\n",serial);
 	env_set("usid", serial);
+	*/
+
+	// kdev hack, setup static usid
+	// USID, Unique Serial ID
+	char serial[64]={0};
+	strcpy(serial, "1A2B3C4D5E6F70");
+	printf("usid:%s\r\n",serial);
+	env_set("usid", serial);
 }
 
 static void get_rtc(void)
@@ -511,6 +520,9 @@ static int do_kbi_init(cmd_tbl_t * cmdtp, int flag, int argc, char * const argv[
 {
 	int khadas_camera_id = 0;//NULL
 
+	// kdev hack
+	return 0;
+
 	// switch to i2c2
 	printf("hlm %s\n", __func__);
 	run_command("i2c dev 3", 0);
-- 
2.43.0

